# ==============================================================================
# ORIGINALITY DESK - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# Never commit credentials or production secrets to version control.

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Active environment profile: development | test | production
# In production mode:
# - DESK_PUBLIC_ORIGIN must use https://
# - DESK_SECURE_COOKIES must be set to true
# - Dynamic port 0 is disallowed
DESK_ENV=development

# ------------------------------------------------------------------------------
# 2. SERVER NETWORK & HOST BINDING
# ------------------------------------------------------------------------------
# The network interface IP address the server will bind to.
# Default: 127.0.0.1 (local loopback).
# For Docker or public containers, use 0.0.0.0.
DESK_HOST=127.0.0.1

# The TCP port the server listener will bind to.
# Default: 8080. (Use 0 only in automated integration tests for dynamic port assignment)
DESK_PORT=8080

# The canonical, browser-visible public origin (Scheme + Host + optional Port).
# CRITICAL FOR SECURITY: Every mutating request (POST, DELETE) must supply an
# Origin header strictly matching this value as protection against CSRF attacks.
# Also, every incoming HTTP request's Host header must equal this origin's authority.
# Default: http://localhost:8080
# Production example: https://originality.university.edu
DESK_PUBLIC_ORIGIN=http://localhost:8080

# Port mapped on the host machine when using Docker Compose.
HOST_PORT=8080

# ------------------------------------------------------------------------------
# 3. STORAGE & PERSISTENCE
# ------------------------------------------------------------------------------
# Directory where SQLite database (server.sqlite3), WAL journals, and uploaded
# document blobs (documents/ subfolder) are stored.
# POSIX permissions 0700 (rwx------) are enforced automatically on startup.
# Default: ./desk-server-data
# Container default: /app/data
DESK_DATA_DIR=./desk-server-data

# ------------------------------------------------------------------------------
# 4. SECURITY & COOKIES
# ------------------------------------------------------------------------------
# Set to 'true' to append the '; Secure' directive to the 'desk_session' cookie.
# REQUIRED in production when served over HTTPS.
# Values: true | false
# Default: false (allows HTTP testing on localhost)
DESK_SECURE_COOKIES=false

# ------------------------------------------------------------------------------
# 5. BACKGROUND PROCESSING & DATA RETENTION
# ------------------------------------------------------------------------------
# Automatic document retention in days.
# When set to a positive integer (e.g., 30, 90, 180), documents and associated
# analyses/snapshots older than this duration are automatically purged by the worker.
# Default: 0 (retention cleanup disabled; files remain until explicitly deleted by user)
DESK_RETENTION_DAYS=0

# Maximum duration in seconds allowed for a single extraction or analysis job
# before it is timed out and marked as FAILED.
# Must be between 5 and 600 seconds.
# Default: 90
DESK_JOB_TIMEOUT_SECONDS=90

# ------------------------------------------------------------------------------
# 6. DESKTOP ASSISTANT OPTIONAL INTEGRATIONS (DESKTOP MODE ONLY)
# ------------------------------------------------------------------------------
# Note: The Originality Desk server and core similarity engine operate 100% locally
# and NEVER transmit submitted documents to third-party AI services.
# The following variable is used solely by the optional legacy desktop writing assistant
# for authorial style rewriting and paraphrase generation:
# GEMINI_API_KEY=your_gemini_api_key_here
